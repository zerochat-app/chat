{
  "rules": {
    ".read": false,
    ".write": false,
    "status": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['online', 'last_seen']) && newData.child('online').isBoolean() && newData.child('last_seen').isString()"
      }
    }
  }
}
